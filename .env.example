# Supabase (Project Settings -> API). Zonder deze variabelen draait de app in demo-modus (in-memory, niet persistent).
# Alle drie zijn nodig; bij een half ingevulde set valt de app terug op demo-modus (met een waarschuwing in de logs).
# SUPABASE_URL wordt ook tijdens de build gelezen voor de Content-Security-Policy (connect-src): na wijzigen opnieuw deployen.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_... of legacy anon key). Wordt alleen gebruikt voor de browser-upload naar een signed URL.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_... of legacy service_role). ALLEEN server-side. Nooit committen, nooit met NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...
# Optioneel: naam van de storage bucket (default: ai-assets). Een eigen bucket moet privé zijn met een limiet van 50 MB.
SUPABASE_BUCKET=ai-assets
