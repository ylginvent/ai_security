# Supabase (Project Settings -> API). Zonder deze variabelen draait de app in demo-modus (in-memory, niet persistent).
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_... of legacy anon key). Wordt alleen gebruikt voor de browser-upload naar een signed URL.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_... of legacy service_role). ALLEEN server-side. Nooit committen.
SUPABASE_SECRET_KEY=sb_secret_...
# Optioneel: naam van de storage bucket (default: ai-assets)
SUPABASE_BUCKET=ai-assets
